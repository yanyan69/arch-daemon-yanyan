#music dir
music_directory    "/storage/601A-BC4D/Music"
playlist_directory "~/.config/mpd/playlists"
db_file            "~/.config/mpd/database"
log_file           "~/.config/mpd/log"
pid_file           "~/.config/mpd/pid"
state_file         "~/.config/mpd/state"
auto_update	   "yes"
bind_to_address    "localhost"
port               "6600"
# audio output routing directly to termux PulseAudio
audio_output {
    type           "audtrack"
    name           "PulseAudio output"
    mixer_type     "software"
    server         "127.0.0.1"
}

#visualizer output for ncmpcpp's built-in visualizer
audio_output {
    type           "fifo"
    name           "my_fifo"
    path           "/tmp/mpd.fifo"
    format         "44100:16:2"
}
