{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "logo": {
        "type": "auto", //install magemagick chafa
        "source": "/data/data/com.termux/files/home/megumin-logo.png",
        "height": 25,
        "padding": { "right": 0 },
        "color": {
            "1": "34",
	    "2": "36",
	    "3": "32"
        }
    },
    "display": {
        "separator": " ⟩ ",
        "color": {
	    "keys": "\u001b[1;38;5;180m",
	    "title": "\u001b[1;38;5;75m"
	}
    },
    "modules": [
        "break",
	"break",
        {
            "type": "title",
            "keyWidth": 8
        },
	{
	    "type": "separator",
	    "string": "-"
	},
        "break",

        // OS CATEGORY
        {
            "type": "os",
            "key": " OS    ",
	    "format": "{name} ({arch})"
        },
        {
            "type": "kernel",
            "key": " ├ CORE",
	    "format": "{sysname} ({release})"
        },
        {
            "type": "packages",
            "key": " └ PKGS",
	    "format": "{pacman} (pacman)",
        },
        "break",

        // ENVIRONMENT CATEGORY
        {
            "type": "terminal",
            "key": " ENV   ",
	    "terminal": "{process-name} ({version})",
        },
        {
            "type": "shell",
            "format": "{pretty-name} ({version})",
            "key": " └ MODE"
        },
	{ "type": "theme", "key": " Theme" },
        "break",
      
        // HARDWARE CATEGORY
	{
	    "type": "displau",
            "key": " RES  ",
            "compactType": "resolution"
	},
        {
            "type": "cpu",
            "format": "{name~27} @{freq-max}",
            "key": " HW    ",
	    "showPeCores": false,
	    "temp": false
        },
        {
            "type": "memory",
            "key": " ├ RAM ",
	    "binaryPrefix": "iec",
	    "percent": {
		"show": true
	    }
        },
        {
            "type": "swap",
            "key": " ├ SWAP"
        },
        {
            "type": "disk",
            "key": " └ DISK",
	    "folders": "/",
	    "format": "{1}/{2} ({3})" //show mount, size, percent
        },
        "break",
      
        // UPTIME CATEGORY
        {
            "type": "command",
            "key": " BOOT  ",
	    "text": "uptime -p | sed 's/up //; s/ days\\?, /d /; s/ hours\\?, /h /; s/ minutes\\?/m/'"
        },
        {
            "type": "datetime",
            "format": "{1}-{3}-{11}",
            "key": " └ DATE"
        },
        "break",
        {
            "type": "custom",
            "format": "          \u001b[31m●  \u001b[33m●  \u001b[32m●  \u001b[36m●  \u001b[34m●  \u001b[35m●  \u001b[37m●\u001b[0m"
	},
	"break",
	"break"
    ]
}
