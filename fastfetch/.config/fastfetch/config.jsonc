{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "logo": {
        "type": "auto", //install magemagick chafa
        "source": "~/arch-daemon-yanyan/assets/.config/.assets/megumin-logo.png",
        "height": 25,
        "padding": { "right": 0 },
        "color": { "1": "34", "2": "36", "3": "32" }
    },
    "display": {
        "separator": " ⟩ ",
        "color": { "keys": "\u001b[1;38;5;180m", "title": "\u001b[1;38;5;75m" }
    },
    "modules": [ "break", "break",
        { "type": "title", "keyWidth": 8 },
	{ "type": "separator", "string": "-" },
        "break",

        // OS
        { "type": "os", "key": " OS    ", "format": "{name} ({arch})" },
	{ "type": "host", "key": " ├ HOST"},
        { "type": "kernel", "key": " ├ CORE", "format": "{sysname} ({release})" },
        { "type": "packages", "key": " └ PKGS" },
        "break",

        // ENVIRONMENT	
        { "type": "terminal", "key": " ENV   ", "format": "{process-name}" },
        { "type": "wm", "key": " ├ GUI ", "format": "{1}" },
	{ "type": "shell", "format": "{pretty-name} ({version})", "key": " ├ MODE" },
	{ "type": "theme", "key": "├ THEME" },
	{ "type": "icons", "key": "└ ICONS" },
        "break",
      
        // HARDWARE 
	{ "type": "displau", "key": " RES  ", "compactType": "resolution" },
        { "type": "cpu", "key": " HW    ", "format": "{name} @{freq-max}", "showPeCores": false, "temp": false },
	{ "type": "gpu", "key": " ├ GPU "},
        { "type": "memory", "key": " ├ RAM ", "binaryPrefix": "iec", "percent": {"show": true } },
        { "type": "swap", "key": " ├ SWAP" },
	{ "type": "disk", "key": " ├ DISK", "folders": "/", "format": "{0} / {2} ({3})" },
	{ "type": "battery", "key": " └ BATT", "format": "{4} [{5}]" },
        "break",

	//NETWORK
	// NETWORK
	{ "type": "localip", "key": " NET   ", "showIpv6": false, "showLoopback": false, "showAllIps": false, "namePrefix": "wlan0", "showPrefix": false, "format": "{1}" },
	{ "type": "localip", "key": " ├ CELL", "showIpv6": false, "showLoopback": false, "showAllIps": false, "namePrefix": "rmnet", "showPrefix": false, "format": "{1}" },
        { "type": "localip", "key": " └ VPN ", "showIpv6": false, "showLoopback": false, "showAllIps": false, "namePrefix": "tun", "showPrefix": false, "format": "{1}" },
	"break",
      
        // UPTIME 
        { "type": "uptime", "key": " BOOT  ", "format": "{1}d {2}h {3}m" },
        { "type": "datetime", "format": "{1}-{3}-{11}", "key": " └ DATE" },
        "break",
        { "type": "custom", "format": "          \u001b[31m●  \u001b[33m●  \u001b[32m●  \u001b[36m●  \u001b[34m●  \u001b[35m●  \u001b[37m●\u001b[0m" },
	"break", "break"
    ]
}
